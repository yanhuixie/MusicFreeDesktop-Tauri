{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicFree",
  "version": "0.0.8",
  "identifier": "fun.upup.musicfree",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "url": "/index.html",
        "title": "Music Free",
        "width": 1050,
        "height": 700,
        "minWidth": 1050,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
